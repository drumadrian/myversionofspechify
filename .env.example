# AWS Credentials Configuration for MyVersionOfSpeechify
# You can paste your credentials here, or set them in your terminal / AWS CLI SSO

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Optional: Required if using temporary credentials or AWS SSO
AWS_SESSION_TOKEN=your_session_token_here

# Server Port (default 5001)
PORT=5001
