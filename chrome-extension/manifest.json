{
  "manifest_version": 3,
  "name": "MyVersionOfSpeechify - Neural AI TTS",
  "version": "1.0.0",
  "description": "Select text or code on any webpage and right-click to read aloud with AWS Polly Neural AI speech synthesis.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyVersionOfSpeechify Studio"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
